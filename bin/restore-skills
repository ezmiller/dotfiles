#!/usr/bin/env bash
# Reinstall skills from skills.sh (`npx skills add -g`) that are listed in
# the tracked lock file but missing on this machine.
#
# The lock file lives at skills/installed-lock.json in this repo and is linked to
# ~/.agents/.skill-lock.json, where the skills CLI records global installs.

set -euo pipefail

LOCK="${HOME}/.agents/.skill-lock.json"
SKILLS_DIR="${HOME}/.agents/skills"

if [[ ! -f "$LOCK" ]]; then
    echo "No skill lock file at $LOCK; nothing to restore."
    exit 0
fi

jq -r '.skills | to_entries[] | [.key, .value.sourceUrl] | @tsv' "$LOCK" |
    while IFS=$'\t' read -r name source; do
        if [[ -d "${SKILLS_DIR}/${name}" ]]; then
            echo "  - ${name}: already installed"
            continue
        fi
        echo "  - ${name}: installing from ${source}"
        npx -y skills add "$source" --skill "$name" --global --agent claude-code --yes </dev/null
    done
